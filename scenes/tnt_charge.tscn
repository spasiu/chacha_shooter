; A planted charge sitting on whatever it was stuck to, counting down. See
; tnt_charge.gd -- once planted it runs on its own clock and is not owned by
; whoever set it.
[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/tnt_charge.gd" id="1_charge"]

[sub_resource type="StandardMaterial3D" id="Mat_stick"]
