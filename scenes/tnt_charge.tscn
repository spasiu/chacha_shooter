roughness = 0.8

[sub_resource type="StandardMaterial3D" id="Mat_band"]
albedo_color = Color(0.16, 0.13, 0.1, 1)
roughness = 0.9

[sub_resource type="StandardMaterial3D" id="Mat_lamp"]
