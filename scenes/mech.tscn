[node name="Mech" type="CharacterBody3D"]
script = ExtResource("1_mech")
; Slower and lighter than the tank it inherits from, and better on its feet: it
; steps over what a hull has to climb, swings its upper body faster than a
; turret ring turns, and elevates far higher because the guns are carried in
; arms rather than laid in a mantlet. The armour is thinner to pay for it -- a
; walker is a tall target that cannot hide behind its own glacis.
drive_speed = 4.6
reverse_speed = 2.0
acceleration = 1.6
turn_speed = 22.0
traverse_speed = 34.0
elevation_min = -14.0
elevation_max = 30.0
step_height = 0.9
fell_headroom = 2.6
max_health = 700.0
; An autocannon: a fraction of the shell, several times the rate.
shell_multiplier = 0.65
main_rounds = 30
main_reload = 1.2
coax_rounds = 300
coax_rpm = 700.0

; One box for the whole machine rather than a shape per limb. The legs swing
; through it and are never collided with in their own right, which is the point:
; a walker whose shins were solid would trip over its own stride on ground the
; hull could have crossed, and every player would read that as the mech being
; stuck on nothing.
[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.95, 0)
shape = SubResource("Shape_body")

