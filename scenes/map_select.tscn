; Map screen, and the game's entry point. Only the frame lives here -- the
; cards are built from MapCatalogue at runtime, so the catalogue is the single
; place a map has to be listed.
[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/map_select.gd" id="1_maps"]

[node name="MapSelect" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_maps")

[node name="Backdrop" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.065, 0.072, 0.065, 1)

[node name="Root" type="VBoxContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 40.0
offset_top = 32.0
offset_right = -40.0
offset_bottom = -32.0
mouse_filter = 2
alignment = 1
; Sixteen rather than eighteen: with the masthead on it this screen is tall
; enough that the two pixels a row matter at the short end of what a browser
; window can be, and nobody can see the difference at the tall end.
theme_override_constants/separation = 16

; The game's name, and the only place a player ever sees it outside the browser
; tab. Kept as its own box with the two lines tight together, because the row
; separation that suits the screen is far too loose for a wordmark and the thing
; underneath is the second half of the joke rather than a separate heading.
;
; The text is filled in from the project's own name at runtime, so renaming the
; game stays a one-line change in project.godot.
[node name="Masthead" type="VBoxContainer" parent="Root"]
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Wordmark" type="Label" parent="Root/Masthead"]
mouse_filter = 2
theme_override_colors/font_color = Color(0.9, 0.85, 0.66, 1)
theme_override_font_sizes/font_size = 56
text = "KILROY"
horizontal_alignment = 1

[node name="Tagline" type="Label" parent="Root/Masthead"]
mouse_filter = 2
theme_override_colors/font_color = Color(0.5, 0.52, 0.47, 1)
theme_override_font_sizes/font_size = 15
text = "was here"
horizontal_alignment = 1

[node name="Title" type="Label" parent="Root"]
mouse_filter = 2
theme_override_colors/font_color = Color(0.93, 0.93, 0.9, 1)
theme_override_font_sizes/font_size = 28
text = "PICK YOUR GROUND"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Root"]
mouse_filter = 2
theme_override_colors/font_color = Color(0.6, 0.62, 0.58, 1)
theme_override_font_sizes/font_size = 16
text = "Every map is its own match."
horizontal_alignment = 1

[node name="Cards" type="HBoxContainer" parent="Root"]
size_flags_horizontal = 4
size_flags_vertical = 4
theme_override_constants/separation = 16

[node name="Status" type="Label" parent="Root"]
mouse_filter = 2
theme_override_colors/font_color = Color(0.55, 0.57, 0.53, 1)
theme_override_font_sizes/font_size = 15
text = "OFFLINE"
horizontal_alignment = 1

[node name="Next" type="Button" parent="Root"]
custom_minimum_size = Vector2(280, 52)
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 20
text = "CHOOSE YOUR KIT"

[node name="Hint" type="Label" parent="Root"]
mouse_filter = 2
theme_override_colors/font_color = Color(0.45, 0.47, 0.44, 1)
theme_override_font_sizes/font_size = 13
text = "Everyone on a map shares a field. The other maps are somebody else's match."
horizontal_alignment = 1
