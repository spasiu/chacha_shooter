[ext_resource type="Texture2D" path="res://assets/textures/cloth_grain.tres" id="5_grain"]

; Composite plate: a hard shell with a matte finish rather than a shine. The
; grain is doing the same job it does on cloth -- a plate lit by one flat number
; across its whole face is what plastic looks like.
[sub_resource type="StandardMaterial3D" id="Mat_uniform"]
albedo_color = Color(0.255, 0.275, 0.225, 1)
albedo_texture = ExtResource("5_grain")
metallic = 0.32
metallic_specular = 0.45
roughness = 0.58
roughness_texture = ExtResource("5_grain")
uv1_scale = Vector3(6, 6, 6)
uv1_triplanar = true

; The bodysuit under it, and every joint the plates cannot cover. Near black and
; almost matte, so it reads as a shadow between panels rather than as another
; panel.
[sub_resource type="StandardMaterial3D" id="Mat_suit"]
