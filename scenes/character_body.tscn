; Infantryman, ~1.6m to the top of the helmet, built from primitives. Origin at
; the feet. Everything above the waist hangs off Spine, which the player pitches
; so the weapon tracks where you are aiming. WeaponSocket is the attachment
; point -- swapping weapons means reparenting a different scene onto it.
;
; The style is toy soldier rather than war photograph: big round helmet, big
; round head under it, two wide-set eyes over a cloth mask, mitten hands and
; boots you could stand a mug on. Everything is a rounded shape with a low
; segment count so the facets show, and every material is one flat colour with
; nothing textured over it. That combination is the whole look -- soft forms
; and hard flat shading. Adding grain or gloss to any of this is what would
; drag it back toward the realistic model it replaced.
;
; The proportions are doing the cute rather than the detail. The head with its
; helmet is nearly a fifth of the height, the limbs are short and thick, and the
; kit is four pieces instead of fifteen: a belt, two pouches, a pack. Anything
; finer than that vanishes at the distance these are actually seen from and
; costs the silhouette its simplicity.
;
; Every anchor the rest of the game reaches for is where it always was: hips at
; y=0.73, knees a 0.315 segment below, Spine at 0.84, the arm rig's shoulders at
; +-0.21 from it, and the bottom of the head on the 1.32 headshot line.
[gd_scene load_steps=38 format=3]

[ext_resource type="Script" path="res://scripts/arm_rig.gd" id="1_rig"]
[ext_resource type="Script" path="res://scripts/character_body.gd" id="4_model"]
[ext_resource type="PackedScene" path="res://scenes/hand_right.tscn" id="2_hand_r"]
[ext_resource type="PackedScene" path="res://scenes/hand_left.tscn" id="3_hand_l"]

; Wool serge, and the only colour most of the model is. Brighter and greener
; than a real 1944 uniform on purpose: this palette has to read at a glance and
; look friendly doing it.
[sub_resource type="StandardMaterial3D" id="Mat_uniform"]
albedo_color = Color(0.4, 0.45, 0.27, 1)
roughness = 0.9
metallic_specular = 0.15

; The helmet, a shade darker and cooler so it separates from the tunic under it.
[sub_resource type="StandardMaterial3D" id="Mat_helmet"]
albedo_color = Color(0.33, 0.38, 0.29, 1)
roughness = 0.78
metallic = 0.15
metallic_specular = 0.35

; Webbing, pack and pouches: pale khaki canvas, the second colour of the model.
[sub_resource type="StandardMaterial3D" id="Mat_webbing"]
albedo_color = Color(0.62, 0.56, 0.37, 1)
roughness = 0.95

[sub_resource type="StandardMaterial3D" id="Mat_leather"]
albedo_color = Color(0.29, 0.2, 0.15, 1)
roughness = 0.7
metallic_specular = 0.25

[sub_resource type="StandardMaterial3D" id="Mat_sole"]
albedo_color = Color(0.16, 0.13, 0.12, 1)
roughness = 0.9

; Bright, warm and flat. A cartoon face is mostly this one colour, so it has to
; be able to carry the whole head on its own.
[sub_resource type="StandardMaterial3D" id="Mat_skin"]
albedo_color = Color(0.95, 0.76, 0.6, 1)
roughness = 0.82

; The scarf over the nose and mouth. Half the face, and the thing that makes two
; eyes read as a face at all.
[sub_resource type="StandardMaterial3D" id="Mat_mask"]
albedo_color = Color(0.55, 0.41, 0.3, 1)
roughness = 0.92

; Eyes and brows. Not black -- a very dark blue, which at this size reads softer
; than black does and is most of the difference between cute and menacing.
[sub_resource type="StandardMaterial3D" id="Mat_eye"]
albedo_color = Color(0.13, 0.15, 0.22, 1)
roughness = 0.55

[sub_resource type="StandardMaterial3D" id="Mat_steel"]
albedo_color = Color(0.42, 0.43, 0.44, 1)
metallic = 0.6
roughness = 0.45

