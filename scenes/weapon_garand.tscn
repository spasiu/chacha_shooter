; M1D sniper Garand with an M84 telescope, assembled from primitives.
; Local space matches the other weapons: barrel fires along -Z, +Y up. Roughly
; life-size (~1.08m long).
;
; Unlike the SMG and the shotgun, most of this rifle's silhouette is wood: one
; stock running butt-to-band with the barrel and gas cylinder exposed only over
; the front fifth, plus an upper handguard over the barrel and a slung leather
; strap underneath.
;
; The scope is centred over the bore. The real M1D offset it to the left so the
; en-bloc clip had a clear path down through the top of the receiver; with it
; centred, Garand throws the clip out to the right instead, from under the tube.
;
; Its tube is drawn with the caps off and culling disabled, so at full zoom you
; are genuinely looking down the inside of it. Note these bases put local +Y
; toward the shooter, so on any tapered part `top_radius` is the rear rim.
[gd_scene load_steps=36 format=3]

[ext_resource type="Script" path="res://scripts/garand.gd" id="1_garand"]

[sub_resource type="StandardMaterial3D" id="Mat_metal"]
albedo_color = Color(0.13, 0.13, 0.145, 1)
metallic = 0.85
roughness = 0.42

; Warmer and redder than the Thompson's furniture: Garand stocks are walnut.
[sub_resource type="StandardMaterial3D" id="Mat_wood"]
albedo_color = Color(0.36, 0.19, 0.1, 1)
roughness = 0.62

[sub_resource type="StandardMaterial3D" id="Mat_leather"]
albedo_color = Color(0.3, 0.21, 0.13, 1)
roughness = 0.85

; Culling off so the tube reads as a tube from outside and as a dark surround
; from the eyepiece. Caps off on the meshes using it, or there is nothing to
; look through.
;
; Unshaded on purpose: with culling off, the inside of the tube is lit by
; normals that point the other way, so the lower inner wall catches the ground
; and glows a flat grey right beside the sight picture. Unshaded makes the
; surround uniformly dark from any angle, which is what it should look like.
[sub_resource type="StandardMaterial3D" id="Mat_scope"]
shading_mode = 0
albedo_color = Color(0.045, 0.045, 0.05, 1)
cull_mode = 2

[sub_resource type="StandardMaterial3D" id="Mat_reticle"]
shading_mode = 0
albedo_color = Color(0.02, 0.02, 0.02, 1)

[sub_resource type="StandardMaterial3D" id="Mat_flash"]
