albedo_texture = ExtResource("2_wood")
roughness = 0.55
uv1_scale = Vector3(18, 18, 3)
uv1_triplanar = true

; Slightly dished, which a flat slab is not: a shield is curved so a round that
; does not arrive square is turned rather than caught.
[sub_resource type="CylinderMesh" id="Mesh_plate"]
material = SubResource("Mat_plate")
top_radius = 0.3
bottom_radius = 0.26
height = 0.04
radial_segments = 20
rings = 1

