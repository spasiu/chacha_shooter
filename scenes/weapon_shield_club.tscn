; Shield and club. See shield_club.gd.
;
; Left arm carries a plate of riveted steel; right carries a length of ash with
; a banded head. Nothing here is period ordnance and nothing pretends to be --
; it is what you end up holding when the ammunition runs out, which is why it is
; the one thing in the catalogue that never needs resupplying.
[gd_scene load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/shield_club.gd" id="1_sc"]
[ext_resource type="Texture2D" path="res://assets/textures/wood_grain.tres" id="2_wood"]

[sub_resource type="StandardMaterial3D" id="Mat_plate"]
albedo_color = Color(0.3, 0.315, 0.35, 1)
metallic = 0.6
roughness = 0.42

[sub_resource type="StandardMaterial3D" id="Mat_rivet"]
albedo_color = Color(0.42, 0.43, 0.46, 1)
metallic = 0.7
roughness = 0.35

[sub_resource type="StandardMaterial3D" id="Mat_ash"]
