; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="KILROY"
run/main_scene="res://scenes/map_select.tscn"
; A dedicated-server export has nobody to show a map chooser to, so it boots
; straight into the server scene. Only builds exported with the dedicated
; server flag carry that feature tag, so every other build is unaffected.
run/main_scene.dedicated_server="res://scenes/server.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

; The connection has to outlive the change from the join screen into the world,
; which is exactly what an autoload is for. It is harmless when there is no
; server to talk to: everything on it turns into a no-op and the game is
; single-player again.
Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32)]
}
shoot={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":82)]
}
aim={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325), Object(InputEventMouseButton,"device":-1,"button_index":2)]
}
slot_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":49)]
}
slot_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":50)]
}
slot_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":51)]
}
slot_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":52)]
}
slot_5={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":53)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194326)]
}
toggle_view={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":86)]
}

[rendering]

renderer/rendering_method="forward_plus"
; Browsers cannot run the Vulkan backend. Without this the web build falls back
; on its own and renders the world flat and untextured; desktop is unaffected.
renderer/rendering_method.web="gl_compatibility"
